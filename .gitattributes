# Normalizacion de finales de linea.
# Los scripts de shell tienen que quedar en LF o no corren en Linux ni en macOS.
* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.iss           text eol=lf
*.spec          text eol=lf
*.md            text eol=lf

# En Windows estos tienen que conservar CRLF para que el CMD los ejecute bien.
*.bat           text eol=crlf

# Binarios: sin normalizar.
*.png           binary
*.ico           binary
*.icns          binary
*.otf           binary
*.ttf           binary
*.woff2         binary
*.dmg           binary
*.exe           binary
*.AppImage      binary
